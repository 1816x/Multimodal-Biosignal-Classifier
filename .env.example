# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# This project is an EDUCATIONAL PROTOTYPE — not an approved medical tool.

# --- Claude API (natural-language explanation layer, Phase 3+) ---
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here
# Model used to generate the explanatory report.
ANTHROPIC_MODEL=claude-sonnet-5

# --- FastAPI service (Phase 1+) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Data (Phase 1+) ---
# Directory where the PPG-DaLiA dataset is downloaded. Gitignored; never commit raw data.
DATA_DIR=./data

# Trained model checkpoint served by POST /predict. Produced by
# `python -m biosignal_model.train` (Phase 2, multimodal by default; use --phase 1 for
# the ECG-only baseline at model/checkpoints/ecg_phase1.pt). Gitignored; never commit
# model artifacts.
MODEL_CHECKPOINT=./model/checkpoints/multimodal_phase2.pt
