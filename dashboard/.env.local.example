# Copy this file to `.env.local` and adjust. `.env.local` is gitignored.
#
# Educational prototype — NOT a medical device.

# Base URL of the FastAPI service the dashboard proxies to. This is a SERVER-ONLY
# variable (deliberately not NEXT_PUBLIC_): the browser only ever calls this app's
# own /api/* routes, which forward to the URL below. Defaults to
# http://127.0.0.1:8000 when unset.
API_BASE_URL=http://127.0.0.1:8000
