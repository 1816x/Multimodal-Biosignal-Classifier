# Keep the Docker build context small (root context is used by api/Dockerfile).
.git
.github
.claude
docs

# Python caches / build artifacts
**/__pycache__
**/*.pyc
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

# Data + model artifacts (gitignored; never in an image)
data/
**/checkpoints/
*.pt
*.pth
*.ckpt
*.pkl

# Node / Next (the dashboard image builds from ./dashboard with its own context)
dashboard/node_modules
dashboard/.next
dashboard/out

# Env files
.env
**/.env
**/.env.local
